{
  "name": "simufeu",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ingest:demo": "tsx scripts/overpass-demo.ts"
  },
  "build": {
    "appId": "com.simufeu.app",
    "productName": "SimuFeu",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "engine/**/*"
    ]
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "osmtogeojson": "3.0.0-beta.5"
  }
}
